# Telegram Mini App initData HMAC. Bo'sh qoldirilgan token tashlab ketiladi.
# Tartib: YUK_BOT_TOKEN, ERP_BOT_TOKEN, TELEGRAM_BOT_TOKEN. Birinchisi mos kelsa qabul.
# Haqiqiy tokenni shu faylga yozmang va logga chiqarmang.

# @briketborbot — /yuk Mini App
YUK_BOT_TOKEN=

# @Blckdmndbrqts_bot — briket-erp ham shu botda ishlaydi
ERP_BOT_TOKEN=

# @briket_mijoz_bot — mijoz boti. HMAC zaxirasi. Nakladnoy va mijoz xabarlari shu tokenda qoladi.
TELEGRAM_BOT_TOKEN=

# Vergul bilan Telegram id. Bo'sh bo'lsa Telegram orqali /yuk hech kimni qo'ymaydi.
# ERP admin paneldagi sessiya (X-Admin-Key) initData siz ham /yuk ni ochadi.
ADMIN_TELEGRAM_IDS=

# Kirish tugmalari uchun webhook sirri. Bo'sh bo'lsa /api/agent/yuk/telegram-webhook 503.
# @briketborbot webhookini shu yerga BURMAYING: u hozir eski Supabase funksiyasida.
YUK_WEBHOOK_SECRET=
